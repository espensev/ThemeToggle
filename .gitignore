# ============================================================================
# ThemeToggle .gitignore
# ============================================================================

# ===================
# Build Artifacts
# ===================
*.obj
*.res
*.aps
*.lnk
*.ilk
*.pdb

# Temporary resource compiler files
RC[a-z]*[0-9]*
RD[a-z]*[0-9]*

# Old backups
*.old
*.bak
*.exe.bak

# ===================
# IDE & Editors
# ===================
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# ===================
# Build Output
# ===================
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ===================
# Deployment
# ===================
deploy/*.zip.old
deploy/temp/
deploy/backup/

# ===================
# Windows
# ===================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# ===================
# Test Files
# ===================
test/
tests/output/
*.test.log

# ===================
# Misc
# ===================
*.swp
*.swo
*~
.DS_Store
